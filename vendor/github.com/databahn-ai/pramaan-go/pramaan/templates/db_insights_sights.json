        },
        "data_plane_id": {
          "type": "keyword"
        },
        "source_id": {
          "type": "keyword"
        },
        "key1": {
          "type": "text",
          "fields": {
            "keyword": {
              "type": "keyword"
            }
          }
        },
        "key2": {
          "type": "text",
          "fields": {
            "keyword": {
              "type": "keyword"
            }
          }
        },
        "key3": {
          "type": "text",
          "fields": {
            "keyword": {
              "type": "keyword"
            }
          }
        },
        "reputation": {
          "type": "keyword"
        },
        "reputation_updated_at": {
          "format": "epoch_millis||yyyy-MM-dd HH:mm:ss||yyyy-MM-dd",
